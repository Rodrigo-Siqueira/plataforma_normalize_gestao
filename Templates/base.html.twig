<!DOCTYPE html>
<html lang="pt-br">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Plataforma Normalize</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ url('assets/css/temaCoresPlataforma.css') }}">
        <link rel="stylesheet" href="{{ url('assets/css/estilo.css') }}">
    </head>

    <body class="vh-100 m-0 p-0 overflow-hidden">
        <div class="d-flex h-100 w-100">

            {# 1. SIDEBAR (Lateral) #}
            {% include 'Layout/sidebar.html.twig' %}

            {# 2. LADO DIREITO (Navbar + Main + Rodapé) #}
            <div class="flex-grow-1 d-flex flex-column h-100" style="min-width: 0;">

                {# CABEÇALHO (Fixo no topo) #}
                <div class="flex-shrink-0">
                    {% include 'Layout/navbar.html.twig' %}
                </div>

                {# CONTEÚDO PRINCIPAL (A única área que rola) #}
                <div class="flex-grow-1 overflow-y-auto d-flex flex-column bg-light">
                    <main class="flex-grow-1 p-4">
                        {% block conteudo %}
                        {% endblock %}
                    </main>
                </div>

                {# RODAPÉ #}
                <div class="flex-shrink-0 bg-white">
                    {% include 'Layout/rodape.html.twig' %}
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="{{ url('assets/js/script.js') }}"></script>
    </body>
</html>
