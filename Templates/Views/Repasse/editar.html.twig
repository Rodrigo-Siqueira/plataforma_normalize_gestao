{# Herda o template base #}
{% extends 'base.html.twig' %}

{# Item em destaque no menu #}
{% set itemAtivo = 'repasse' %}

{% block conteudo %}

{# EXIBIÇÃO DE ERRO GLOBAL #}
{% if erros.global is defined %}
<div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
    <span class="material-symbols-outlined me-2 align-middle">
        error
    </span>
    {{ erros.global }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
</div>
{% endif %}

{# CARD DE EDIÇÃO DO REPASSE #}
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-transparent border-info">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h4 class="card-title mb-0 text-primary d-flex align-items-center">
                <span class="material-symbols-outlined me-2 text-primary">
                    edit_note
                </span>
                Editar lote de repasse
            </h4>

            {% if repasse.status.value == 'PAGO' %}
            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                Pago
            </span>
            {% else %}
            <span
                class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                Aberto
            </span>
            {% endif %}
        </div>
    </div>

    <div class="card-body">
        <form action="{{ url('repasses/editar/' ~ repasse.id) }}" method="POST" class="row g-3">
            {#
            CAMPOS OCULTOS NECESSÁRIOS PARA O RepasseInputDTO.
            O Service preservará estes dados e atualizará somente o valor líquido.
            #}
            <input type="hidden" name="id" value="{{ repasse.id }}">
            <input type="hidden" name="psicologoId" value="{{ repasse.psicologoId }}">
            <input type="hidden" name="periodoInicial" value="{{ repasse.periodoInicial|date('Y-m-d') }}">
            <input type="hidden" name="periodoFinal" value="{{ repasse.periodoFinal|date('Y-m-d') }}">
            <input type="hidden" name="status" value="{{ repasse.status.value }}">

            {% if repasse.dataPagamento %}
            <input type="hidden" name="dataPagamento" value="{{ repasse.dataPagamento|date('Y-m-d H:i:s') }}">
            {% endif %}

            {# CÓDIGO #}
            <div class="col-md-3">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="idExibicao"
                        value="{{ repasse.id }}" placeholder="Código" readonly>
                    <label for="idExibicao">Código</label>
                </div>
            </div>

            {# PSICÓLOGO #}
            <div class="col-md-9">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="psicologoNome"
                        value="{{ repasse.psicologoNome ?? 'Não informado' }}" placeholder="Psicólogo" readonly>
                    <label for="psicologoNome">Psicólogo</label>
                </div>
            </div>

            {# PERÍODO INICIAL #}
            <div class="col-md-3">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="periodoInicialExibicao"
                        value="{{ repasse.periodoInicial|date('d/m/Y') }}" placeholder="Período inicial" readonly>
                    <label for="periodoInicialExibicao">Período inicial</label>
                </div>
            </div>

            {# PERÍODO FINAL #}
            <div class="col-md-3">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="periodoFinalExibicao"
                        value="{{ repasse.periodoFinal|date('d/m/Y') }}" placeholder="Período final" readonly>
                    <label for="periodoFinalExibicao">Período final</label>
                </div>
            </div>

            {# DATA DE GERAÇÃO #}
            <div class="col-md-3">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="dataGeracao"
                        value="{{ repasse.dataGeracao|date('d/m/Y H:i') }}" placeholder="Data de geração" readonly>
                    <label for="dataGeracao">Data de geração</label>
                </div>
            </div>

            {# DATA DE PAGAMENTO #}
            <div class="col-md-3">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="dataPagamentoExibicao"
                        value="{% if repasse.dataPagamento %}{{ repasse.dataPagamento|date('d/m/Y H:i') }}{% else %}Não pago{% endif %}"
                        placeholder="Data de pagamento" readonly>
                    <label for="dataPagamentoExibicao">Data de pagamento</label>
                </div>
            </div>

            {# VALOR LÍQUIDO EDITÁVEL #}
            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <input type="number"
                        class="form-control form-material {% if erros.valorLiquido is defined %}is-invalid{% endif %}"
                        id="valorLiquido" name="valorLiquido" min="0.01" step="0.01"
                        value="{{ dados.valorLiquido ?? repasse.valorLiquido }}" placeholder="Valor líquido" required>
                    <label for="valorLiquido">Valor líquido do repasse</label>
                    {% if erros.valorLiquido is defined %}
                    <div class="invalid-feedback">
                        {{ erros.valorLiquido }}
                    </div>
                    {% endif %}
                </div>
            </div>

            {# STATUS #}
            <div class="col-md-6">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control form-material bg-light" id="statusExibicao"
                        value="{% if repasse.status.value == 'PAGO' %}Pago{% else %}Aberto{% endif %}"
                        placeholder="Status" readonly>
                    <label for="statusExibicao">Status</label>
                </div>
            </div>

            {# AVISO SOBRE A EDIÇÃO #}
            <div class="col-12">
                <div class="alert alert-warning d-flex align-items-start mb-0" role="alert">
                    <span class="material-symbols-outlined me-2">
                        warning
                    </span>
                    <div>
                        <strong>Correção manual do valor</strong>
                        <span class="d-block">
                            Esta edição altera somente o valor líquido consolidado do lote. As sessões vinculadas, o
                            status, o psicólogo e o período não serão modificados.
                        </span>
                    </div>
                </div>
            </div>

            {# BOTÕES #}
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success d-flex align-items-center px-4">
                    <span class="material-symbols-outlined me-2 icon-light">
                        save
                    </span>
                    Atualizar valor
                </button>

                <a href="{{ url('repasses/listar') }}" class="btn btn-danger d-flex align-items-center px-4">
                    <span class="material-symbols-outlined me-2 icon-light">
                        cancel
                    </span>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

{# SESSÕES VINCULADAS AO LOTE #}
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-transparent border-info">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h5 class="card-title mb-0 text-primary d-flex align-items-center">
                <span class="material-symbols-outlined me-2">
                    event_note
                </span>
                Sessões vinculadas ao lote
            </h5>

            <span class="badge rounded-pill text-bg-primary px-3 py-2">
                Total: {{ sessoesDoLote|default([])|length }}
            </span>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Paciente</th>
                        <th>Psicólogo</th>
                        <th>Data</th>
                        <th>Hora</th>
                        <th>Valor do repasse</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    {% for sessao in sessoesDoLote %}
                    <tr>
                        <td>{{ sessao.sessao_id }}</td>
                        <td>{{ sessao.paciente_nome }}</td>
                        <td>{{ sessao.psicologo_nome }}</td>
                        <td>{{ sessao.data_agendada|date('d/m/Y') }}</td>
                        <td>{{ sessao.hora_agendada|date('H:i') }}</td>
                        <td>R$ {{ sessao.valor_repasse|number_format(2, ',', '.') }}</td>
                        <td>
                            <span
                                class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                                Realizada
                            </span>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Não há sessões vinculadas a este lote.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>

                {% if sessoesDoLote is not empty %}
                <tfoot class="table-light">
                    <tr>
                        <th colspan="5" class="text-end">Total das sessões:</th>
                        <th>
                            {% set totalSessoes = 0 %}
                            {% for sessao in sessoesDoLote %}
                            {% set totalSessoes = totalSessoes + sessao.valor_repasse %}
                            {% endfor %}
                            R$ {{ totalSessoes|number_format(2, ',', '.') }}
                        </th>
                        <th></th>
                    </tr>
                </tfoot>
                {% endif %}
            </table>
        </div>
    </div>
</div>

{% endblock %}